// Realtime X300/TwinRX configuration. Runtime values are unchanged.
// JSONC allows // and /* */ comments. Keep keys quoted; no trailing commas.
// Runtime notes only; RF proof and open issues are in docs/progress_tracker.md.
{
  // ============================================================
  // 1. USRP receiver
  // ============================================================

  // ---- 1.1 Device, channels and RF tuning ----

  // X300 device address; explicit UHD arguments override defaults below.
  "usrp_addr": "addr=192.168.40.2",

  // Fixed RX order; port, LO and calibration arrays follow this order.
  "channels": [0, 1, 2, 3],

  // RX/steering frequency, Hz; GPS L1, not the wideband TX center.
  "center_freq_hz": 1575420000.0,

  // Complex samples/s per channel; also drives GNSS input rates.
  "sample_rate": 4000000.0,

  "gain_db": 45.0,  // USRP receive gain, dB; not bladeRF TX gain.

  // ---- 1.2 UHD host-side buffering ----

  "recv_frame_size": 8000,  // Receive frame bytes; 8000 requires the jumbo-frame path.
  "send_frame_size": 8000,  // UHD transport frame bytes; this app does not transmit.

  // Requested host RX buffer, bytes; OS limits still apply.
  "recv_buff_size": 50000000,

  "num_recv_frames": 4096,  // Requested UHD receive-frame count.

  // ---- 1.3 TwinRX ports and shared local oscillator wiring ----

  // Antenna ports, in RX-channel order.
  "rx_antennas_by_channel": ["RX1", "RX2", "RX1", "RX2"],

  // LO routing; must match the TwinRX wiring.
  "rx_lo_sources_by_channel": ["internal", "companion", "reimport", "reimport"],

  // LO exports, in RX-channel order.
  "rx_lo_exports_by_channel": [true, false, false, false],

  "lo_lock_timeout_s": 30.0,  // Startup LO-lock deadline, seconds.


  // ============================================================
  // 2. Array calibration and DoA
  // ============================================================

  // ---- 2.1 Array geometry and correction file ----

  "array_spacing_m": 0.07,  // Square-array element spacing, metres.

  // Manifest metadata only; steering uses center_freq_hz.
  "array_design_freq_hz": 1585000000.0,

  // Saved four-channel IQ corrections, loaded at startup.
  "phase_calibration_file": "configs/calibration/x300_phase_offsets_added_hw_100khz.json",

  // Apply saved phase and amplitude corrections.
  "calibration_correction_mode": "complex_gain",

  // ---- 2.2 MUSIC scan grid and subspace dimension ----

  "doa_min_deg": 0.0,  // Internal scan start, degrees; not a known jammer bearing.
  "doa_max_deg": 359.0,  // Internal scan end, degrees (included).
  "doa_points": 1441,  // Scan-grid points; not a physical accuracy guarantee.
  "expected_sources": 1,  // MUSIC signal-subspace dimension, not PRN count.

  // ---- 2.3 Receive-side phase diagnostic ----

  // Use tone-bin phase diagnostics when true; no TX is started.
  "live_phase_monitor_use_tone_bin": false,

  // RX tone-search hint, Hz; used only when tone monitoring is on.
  "phase_monitor_tone_offset_hz": 100000.0,


  // ============================================================
  // 3. Processing, display and RX health
  // ============================================================

  // ---- 3.1 IQ chunks and heavy-DSP scheduling ----

  "samples_per_chunk": 32768,  // Complex samples/channel/chunk; 8.192 ms at 4 MS/s.
  "process_every_n_chunks": 15,  // Heavy DSP every N chunks; GNSS IQ remains full-rate.

  // Minimum heavy-DSP interval, seconds (launcher floor: 0.02).
  "dsp_update_interval_s": 0.1,

  // ---- 3.2 GUI refresh controls ----

  "ui_update_interval_s": 0.1,  // General display interval, seconds (minimum 0.1).

  // PRN/C/N0 display interval, seconds (minimum 0.1).
  "prn_chart_update_interval_s": 0.1,

  "skyplot_update_interval_s": 0.1,  // Skyplot refresh interval, seconds (minimum 0.1).
  "ui_points": 200,  // Preview sizing hint; not the DoA grid or GNSS channel count.

  // ---- 3.3 Overflow and clipping indicators ----

  "startup_grace_s": 1.5,  // Initial RX overflow/timeout grace period, seconds.

  // Stop at either threshold below; no automatic rate change.
  "stop_on_overflow": true,

  "max_overflow_streak": 30,  // Post-grace overflow streak that triggers a stop.
  "max_total_overflow": 250,  // Total post-grace overflows that trigger a stop.
  "rx_clipping_component_threshold": 0.98,  // Near-full-scale absolute I or Q level.

  // Clipping flag at 0.1%; aggregated across RX channels.
  "rx_clipping_fraction_threshold": 0.001,


  // ============================================================
  // 4. Measured-U1 LCMV protection
  // ============================================================

  // ---- 4.1 Automatic arming and healthy-reference collection ----

  // Every run starts uniform. Healthy GNSS and a stable, fresh measured
  // reference arm protection automatically; jammer evidence activates nulling.
  // Arming and reference collection are mandatory, not manual on/off controls.

  // History length in angle updates, not RF samples.
  "lcmv_realtime_preserve_window_samples": 40,

  // Accepted angle updates required for a stable cluster.
  "lcmv_realtime_preserve_min_samples": 20,

  // Maximum cluster spread, degrees.
  "lcmv_realtime_preserve_max_circular_std_deg": 15.0,

  // Maximum accepted step, degrees; reseed after five rejects.
  "lcmv_realtime_preserve_max_step_deg": 30.0,

  // Guard/reference tolerance, degrees; not an authored bearing.
  "lcmv_realtime_preserve_guard_deg": 20.0,

  // Maximum healthy-reference age when arming, seconds.
  "lcmv_realtime_preserve_max_reference_age_s": 2.0,

  // ---- 4.2 Interference activation and hysteretic release ----

  // Input-power rise, dB; BOTH activation thresholds must pass.
  "lcmv_jammer_activation_min_input_power_jump_db": 3.0,

  // Whitened covariance-mode growth required, dB.
  "lcmv_jammer_activation_min_generalized_gain_db": 6.0,

  // Release input-power ceiling, dB; BOTH release metrics apply.
  "lcmv_jammer_release_max_input_power_jump_db": 1.5,

  // Release covariance-mode ceiling, dB.
  "lcmv_jammer_release_max_generalized_gain_db": 3.0,

  // Low-evidence hold, seconds; exception gap: see progress_tracker.md.
  "lcmv_jammer_release_hold_s": 2.0,

  // ---- 4.3 Measured-vector solve, safety and transitions ----

  // Reject ill-conditioned covariance/constraint systems.
  "lcmv_condition_number_limit": 100000000.0,

  // Loading = this * real(trace(R))/N + the absolute term.
  "lcmv_covariance_diagonal_loading_rel": 0.001,

  // Absolute loading in covariance-power units, not dB.
  "lcmv_covariance_diagonal_loading_abs": 0.0,

  "lcmv_max_weight_norm": 8.0,  // Maximum complex weight norm; limits amplification.

  // Diagnostic only in live measured-U1; NOT a rejection gate.
  "lcmv_max_white_noise_gain_db": 15.0,

  // Required calculated U1 attenuation, dB; not OTA suppression.
  "lcmv_min_predicted_jammer_suppression_db": 18.0,

  "lcmv_weight_transition_s": 1.0,  // Common-weight transition duration, seconds.

  // ---- 4.4 GNSS per-channel continuity on one shared spatial solution ----

  // GNSS continuity transition, seconds; one shared spatial solve.
  "gnss_shared_u1_phase_transition_s": 1.0,

  // Quality-passing vector measurements per satellite.
  "gnss_shared_u1_phase_min_quality_measurements": 3,


  // ============================================================
  // 5. GNSS-SDR process and FIFO input
  // ============================================================

  // ---- 5.1 Receiver process and source-build selection ----

  // Run the integrated receiver on live beamformed FIFO input.
  "gnss_sdr_enable": true,

  // null: search configured source-build/install candidates.
  "gnss_sdr_executable": null,

  // Source-tree location; does not derive the build/install paths.
  "gnss_sdr_repo_dir": "gnss-sdr",

  // Check src/main/gnss-sdr under this build directory.
  "gnss_sdr_build_dir": "gnss-sdr/build-antijamming",

  // Check this local prefix after the build candidate.
  "gnss_sdr_install_dir": "gnss-sdr/install",

  // FIFO startup deadline, seconds; 0 waits while child is alive.
  "gnss_sdr_startup_timeout_s": 0.0,

  // ---- 5.2 Rendered configuration and stream layout ----

  // Receiver template; configs/gnss-sdr is not another checkout.
  "gnss_sdr_config_template": "configs/gnss-sdr/fifo_gps_l1.conf.template",

  // Live FIFOs and generated configuration; needed without logs.
  "gnss_sdr_runtime_dir": "logs/gnss-sdr/runtime",

  // complex64: float32 I + Q, 8 bytes/sample; not SC16 Q11.
  "gnss_sdr_sample_type": "gr_complex",

  // Dynamic GPS L1 slots AND FIFO sources, not fixed PRNs.
  "gnss_1c_channel_count": 10,

  // Concurrent acquisition slots; cannot exceed channel count.
  "gnss_channels_in_acquisition": 10,

  // Raw-IQ chunks; here about 512 MiB / 4.194 s, plus overhead.
  "gnss_feed_queue_maxsize": 512,


  // ============================================================
  // 6. GPS L1 acquisition and tracking
  // ============================================================

  // ---- 6.1 Acquisition search ----

  // Coherent acquisition duration, milliseconds.
  "gnss_acquisition_coherent_integration_ms": 1,

  // Probability used to calculate the detection threshold.
  "gnss_acquisition_pfa": 0.01,

  // Search roughly +/- this frequency, Hz, about zero IF.
  "gnss_acquisition_doppler_max_hz": 10000,

  "gnss_acquisition_doppler_step_hz": 250,  // Acquisition search-bin spacing, Hz.

  // Doubled-window bit-transition handling; one-dwell decision.
  "gnss_acquisition_bit_transition_flag": false,

  // Maximum noncoherent dwells in normal acquisition.
  "gnss_acquisition_max_dwells": 1,

  // ---- 6.2 Normal tracking loops ----

  "gnss_tracking_1c_pll_bw_hz": 35.0,  // Normal carrier-loop bandwidth, Hz.
  "gnss_tracking_1c_dll_bw_hz": 0.5,  // Normal code-loop bandwidth, Hz.
  "gnss_tracking_1c_pll_filter_order": 3,  // Carrier-loop filter order.
  "gnss_tracking_1c_dll_filter_order": 2,  // Code-loop filter order.

  // Each tap at +/- this distance from prompt, code chips.
  "gnss_tracking_1c_early_late_space_chips": 0.25,

  // ---- 6.3 Extended integration and its narrow tracking parameters ----

  // 1 keeps 1 ms integration; narrow settings below are inactive.
  "gnss_tracking_1c_extend_correlation_symbols": 1,

  // Extended-integration carrier bandwidth, Hz; inactive here.
  "gnss_tracking_1c_pll_bw_narrow_hz": 5.0,

  // Extended code bandwidth, Hz; 0.75 is not below normal 0.5.
  "gnss_tracking_1c_dll_bw_narrow_hz": 0.75,

  // Extended-integration tap offset, chips; inactive here.
  "gnss_tracking_1c_early_late_space_narrow_chips": 0.15,

  // ---- 6.4 Frequency-lock pull-in and synchronization limits ----

  // Frequency-lock assistance during initial tracking.
  "gnss_tracking_1c_enable_fll_pull_in": true,

  // Keep frequency-lock assistance after pull-in.
  "gnss_tracking_1c_enable_fll_steady_state": false,

  "gnss_tracking_1c_fll_bw_hz": 10.0,  // Frequency-lock-loop bandwidth, Hz.
  "gnss_tracking_1c_pull_in_time_s": 2,  // Initial tracking pull-in duration, seconds.

  // Tracking synchronization deadline, seconds; not PVT timeout.
  "gnss_tracking_1c_bit_synchronization_time_limit_s": 30,

  // Decoded time-of-week feedback; not spatial phase compensation.
  "gnss_tow_to_trk": true,


  // ============================================================
  // 7. PVT, assistance and live monitors
  // ============================================================

  // ---- 7.1 PVT solver and position repeatability ----

  // Stationary PPP solver; estimates position from receiver observations.
  "gnss_pvt_positioning_mode": "PPP_Static",

  "gnss_pvt_elevation_mask_deg": 15.0,  // Satellite elevation mask for PVT, degrees.

  // Minimum fixes for CEP about the run's measured mean; at least two.
  // Horizontal repeatability, not absolute accuracy or a rolling window.
  "gnss_accuracy_window_points": 2,

  // ---- 7.2 Optional local assisted-GNSS inputs ----

  "gnss_agnss_xml_enable": false,  // Local assistance XML; disabled in this profile.

  // Optional receiver assistance; not SignalSim RINEX.
  "gnss_agnss_gps_ephemeris_xml": "configs/gnss-sdr/assistance/gps_ephemeris.xml",

  // Optional latitude,longitude assistance; empty: none authored.
  "gnss_agnss_ref_location": "",

  // DD/MM/YYYY HH:MM:SS UTC; empty: host-clock assistance guess.
  "gnss_agnss_ref_utc_time": "",

  // ---- 7.3 PVT UDP monitor (operational position data, not debug logging) ----

  // Live position/time/accuracy feed, not debug logging.
  "gnss_pvt_monitor_enable": true,

  // Keep loopback for the local bridge.
  "gnss_pvt_monitor_client_addresses": "127.0.0.1",

  // PVT UDP port; distinct from other monitor ports.
  "gnss_pvt_monitor_udp_port": "1111",

  // Required packet encoding when this monitor is enabled.
  "gnss_pvt_monitor_enable_protobuf": true,

  // ---- 7.4 Observable/channel UDP monitor ----

  "gnss_monitor_enable": true,  // Live observable/channel-state feed.
  "gnss_monitor_client_addresses": "127.0.0.1",  // Local bridge UDP destination.
  "gnss_monitor_udp_port": "1112",  // Observable-monitor UDP port.

  // Required encoding when this monitor is enabled.
  "gnss_monitor_enable_protobuf": true,

  // Monitor-record decimation, NOT RF sample decimation or Hz.
  "gnss_monitor_decimation_factor": 1700,

  // ---- 7.5 Tracking UDP monitor and live NMEA ----

  // Live PRN/C/N0 and continuity data; not debug logging.
  "gnss_tracking_monitor_enable": true,

  // Local bridge UDP destination.
  "gnss_tracking_monitor_client_addresses": "127.0.0.1",

  "gnss_tracking_monitor_udp_port": "1236",  // Tracking-monitor UDP port.

  // Required encoding when this monitor is enabled.
  "gnss_tracking_monitor_enable_protobuf": true,

  // Tracking-record decimation; IQ/tracking rates unchanged.
  "gnss_tracking_monitor_decimation_factor": 10,

  "gnss_pvt_nmea_tty_enable": true,  // Live NMEA over the bridge-owned pseudo-terminal.
  "gnss_pvt_nmea_rate_ms": 1000,  // NMEA output interval, milliseconds.


  // ============================================================
  // 8. Diagnostic logging
  // ============================================================

  // ---- 8.1 Logging switch and evidence locations ----

  // Optional persistence; live stdout/UDP/NMEA/FIFOs stay active.
  "logging_enabled": true,

  "log_dir": "logs",  // Application session evidence directory.

  // Receiver log base; persistence follows logging_enabled.
  "gnss_sdr_log_dir": "logs/gnss-sdr/glog",

  // ---- 8.2 Periodic diagnostics (not receiver processing rates) ----

  // Receive chunks between health summaries/statistic resets.
  "rx_health_log_interval_chunks": 200,

  // Phase/DoA/LCMV text-log interval, seconds; 0: every update.
  "doa_log_interval_s": 1.0,

  // Full spatial-diagnostic interval, seconds; 0: every update.
  "lcmv_heavy_diagnostics_interval_s": 1.0
}
